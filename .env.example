# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: For commercial tiering and tenant subscription management.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: For verifying raw Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=""

# SLACK_BOT_TOKEN: For dispatching real-time micro-lessons to users.
SLACK_BOT_TOKEN=""

# ============================================================================
# PHASE A HARDENING: Encryption Key Management (SOC 2 CC6.7)
# ============================================================================
# ENCRYPTION_MASTER_KEY (REQUIRED for production)
#
# Production deployments MUST provide a cryptographically random 32-byte key
# as a 64-character hexadecimal string. This key is used for AES-256-GCM
# encryption of sensitive data at rest.
#
# SECURITY REQUIREMENTS:
# - Key must be 64-character hex (32 bytes / 256 bits)
# - Key must come from a cryptographically secure random source
# - Key must never be hard-coded or embedded in source code
# - Key must be injected via secure secret management (see below)
# - Key must be rotated annually per SOC 2 CC6.7
# - Key value must NEVER appear in logs, errors, or responses
#
# STARTUP BEHAVIOR:
# - Application fails immediately if ENCRYPTION_MASTER_KEY is not set
# - Application fails immediately if ENCRYPTION_MASTER_KEY format is invalid
# - No fallback, no default, no hard-coded substitute
#
# HOW TO GENERATE A KEY:
# Using OpenSSL:
#   openssl rand -hex 32
#
# Using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Example (DO NOT USE IN PRODUCTION - for testing only):
#   ENCRYPTION_MASTER_KEY="a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1"
#
# PRODUCTION DEPLOYMENT OPTIONS:
#
# Option 1: Kubernetes Secret (recommended for K8s)
#   kubectl create secret generic soc2-encryption \
#     --from-literal=ENCRYPTION_MASTER_KEY="<64-char-hex-string>"
#   # Mount in pod:
#   env:
#     - name: ENCRYPTION_MASTER_KEY
#       valueFrom:
#         secretKeyRef:
#           name: soc2-encryption
#           key: ENCRYPTION_MASTER_KEY
#
# Option 2: AWS Secrets Manager (recommended for AWS)
#   aws secretsmanager create-secret \
#     --name soc2/encryption-key \
#     --secret-string "<64-char-hex-string>"
#   # Inject at container startup via environment variable
#
# Option 3: Google Cloud Secret Manager (recommended for GCP)
#   echo -n "<64-char-hex-string>" | \
#     gcloud secrets create soc2-encryption-key --data-file=-
#   # Mount as environment variable in Cloud Run/GKE
#
# Option 4: HashiCorp Vault (recommended for self-hosted)
#   vault kv put secret/soc2/encryption key="<64-char-hex-string>"
#   # Inject via Vault Agent init container
#
# TESTING / LOCAL DEVELOPMENT ONLY:
# For local development, generate a temporary test key:
#   export ENCRYPTION_MASTER_KEY="$(openssl rand -hex 32)"
#   npm start
#
# NEVER commit this value to version control.
# NEVER use the same key across production and staging/test environments.
# NEVER log or print the key value.
#
ENCRYPTION_MASTER_KEY=""

# AWS Credentials for STS Cross-Account Assumption (Optional / fallback)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
